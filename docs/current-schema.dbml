// Implemented PostgreSQL schema, through 002_budget_plans.sql.
// Sources: apps/api/migrations/*.sql and apps/api/src/migrate.ts.
// Describes a database with all repository migrations applied; not a live DB dump.
// docs/data-model.dbml is the separate candidate/design model.
// PostgreSQL extension: pgcrypto (001_core.sql).
// CHECK expressions and index sort directions are recorded in notes below.
// Only database-enforced constraints are documented here, not API-only rules.

Enum user_role {
  admin
  user
}

Enum account_permission {
  owner
  editor
  viewer
}

Enum transaction_status {
  pending
  posted
}

Enum budget_period_type {
  monthly
  yearly
}

Enum budget_line_type {
  income
  expense
}

Table schema_migrations {
  name text [pk, not null]
  applied_at timestamptz [not null, default: `now()`]

  Note: 'Created by apps/api/src/migrate.ts before SQL migrations run.'
}

Table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email varchar(320) [not null, unique]
  password_hash text [not null]
  role user_role [not null, default: 'user']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash text [not null, unique]
  expires_at timestamptz [not null]
  last_seen_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, expires_at) [name: 'sessions_user_expiry_idx', type: btree]
  }
}

Table idempotency_keys {
  user_id uuid [not null]
  key varchar(255) [not null]
  response_status integer [not null]
  response_body jsonb [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, key) [pk]
  }
}

Table accounts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  owner_user_id uuid [not null]
  name varchar(120) [not null]
  account_number_ciphertext bytea [not null]
  account_number_iv bytea [not null]
  account_number_auth_tag bytea [not null]
  encryption_key_version integer [not null, default: 1]
  account_number_last_four varchar(4) [not null, note: 'CHECK (account_number_last_four ~ \'^[0-9]{4}$\')']
  starting_balance_cents bigint [not null, default: 0]
  currency char(3) [not null, default: 'USD', note: 'CHECK (currency = \'USD\')']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table account_memberships {
  account_id uuid [not null]
  user_id uuid [not null]
  permission account_permission [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, user_id) [pk]
  }
}

Table categories {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  name varchar(100) [not null]
  is_archived boolean [not null, default: false]
  is_system boolean [not null, default: false]
  system_key varchar(50)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
    (user_id, system_key) [unique]
  }
}

Table transfers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  occurred_on date [not null]
  notes text
  reverses_transfer_id uuid [unique]
  created_at timestamptz [not null, default: `now()`]
}

Table transactions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  account_id uuid [not null]
  occurred_on date [not null]
  amount_cents bigint [not null, note: 'CHECK (amount_cents <> 0)']
  currency char(3) [not null, default: 'USD', note: 'CHECK (currency = \'USD\')']
  description varchar(500) [not null]
  identifier varchar(255)
  category_id uuid [not null]
  notes text
  status transaction_status [not null, default: 'posted']
  reconciled_at timestamptz
  reconciled_by_user_id uuid
  transfer_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by_user_id uuid
  version integer [not null, default: 1]

  indexes {
    (account_id, occurred_on, created_at, id) [name: 'transactions_ledger_idx', type: btree, note: 'SQL ordering: account_id ASC, occurred_on DESC, created_at DESC, id DESC.']
    (category_id, occurred_on) [name: 'transactions_category_idx', type: btree]
  }
}

Table budgets {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  category_id uuid [not null]
  period_type budget_period_type [not null]
  period_start date [not null]
  planned_amount_cents bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, category_id, period_type, period_start) [unique]
  }

  Note: 'Original budget table; retained alongside budget_lines and budget_line_months.'
}

Table budget_lines {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  account_id uuid [not null]
  budget_year integer [not null, note: 'CHECK (budget_year BETWEEN 1900 AND 2200)']
  line_type budget_line_type [not null]
  name varchar(200) [not null]
  category_id uuid [not null]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, budget_year) [name: 'budget_lines_account_year_idx', type: btree]
  }
}

Table budget_line_months {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  budget_line_id uuid [not null]
  month integer [not null, note: 'CHECK (month BETWEEN 1 AND 12)']
  amount_cents bigint [not null, note: 'CHECK (amount_cents >= 0)']
  checked_at timestamptz

  indexes {
    (budget_line_id, month) [unique]
  }
}

// Unspecified referential actions in the SQL migrations use PostgreSQL NO ACTION.
Ref: sessions.user_id > users.id [delete: cascade, update: no action]
Ref: idempotency_keys.user_id > users.id [delete: cascade, update: no action]
Ref: accounts.owner_user_id > users.id [delete: no action, update: no action]
Ref: account_memberships.account_id > accounts.id [delete: cascade, update: no action]
Ref: account_memberships.user_id > users.id [delete: cascade, update: no action]
Ref: categories.user_id > users.id [delete: cascade, update: no action]
Ref: transfers.user_id > users.id [delete: no action, update: no action]
Ref: transfers.reverses_transfer_id > transfers.id [delete: no action, update: no action]
Ref: transactions.user_id > users.id [delete: no action, update: no action]
Ref: transactions.account_id > accounts.id [delete: no action, update: no action]
Ref: transactions.category_id > categories.id [delete: no action, update: no action]
Ref: transactions.reconciled_by_user_id > users.id [delete: no action, update: no action]
Ref: transactions.transfer_id > transfers.id [delete: no action, update: no action]
Ref: transactions.deleted_by_user_id > users.id [delete: no action, update: no action]
Ref: budgets.user_id > users.id [delete: no action, update: no action]
Ref: budgets.category_id > categories.id [delete: no action, update: no action]
Ref: budget_lines.user_id > users.id [delete: no action, update: no action]
Ref: budget_lines.account_id > accounts.id [delete: no action, update: no action]
Ref: budget_lines.category_id > categories.id [delete: no action, update: no action]
Ref: budget_line_months.budget_line_id > budget_lines.id [delete: cascade, update: no action]
