// Candidate PostgreSQL data model for the Personal Finance Manager.
// Derived values such as account balances are intentionally not persisted.

Enum user_role {
  admin
  user
}

Enum account_permission {
  owner
  editor
  viewer
}

Enum transaction_status {
  pending
  posted
}

Enum scheduled_occurrence_status {
  pending
  confirmed
  skipped
}

Enum export_status {
  queued
  running
  ready
  failed
  expired
}

Enum budget_period_type {
  monthly
  yearly
}

Table users {
  id uuid [pk, not null]
  email varchar(320) [not null, unique]
  password_hash varchar(255) [not null, note: 'Argon2id hash only; never store a password.']
  role user_role [not null, default: 'admin']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sessions {
  id uuid [pk, not null]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique, note: 'Hash of an opaque session token.']
  expires_at timestamptz [not null]
  last_seen_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, expires_at)
  }
}

Table accounts {
  id uuid [pk, not null]
  owner_user_id uuid [not null]
  name varchar(120) [not null]
  account_number_ciphertext bytea [not null]
  account_number_iv bytea [not null]
  account_number_auth_tag bytea [not null]
  encryption_key_version integer [not null, default: 1]
  account_number_last_four varchar(4) [not null]
  starting_balance_cents bigint [not null, default: 0]
  currency char(3) [not null, default: 'USD', note: 'V1 permits USD only.']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_user_id, is_active)
  }
}

Table account_memberships {
  account_id uuid [not null]
  user_id uuid [not null]
  permission account_permission [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, user_id) [pk]
    (user_id, permission)
  }
}

Table categories {
  id uuid [pk, not null]
  user_id uuid [not null]
  name varchar(100) [not null]
  is_archived boolean [not null, default: false]
  is_system boolean [not null, default: false]
  system_key varchar(50) [note: 'The protected transfer category uses XFER_ACCOUNTS.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
    (user_id, system_key) [unique]
    (user_id, is_archived)
  }
}

Table transfers {
  id uuid [pk, not null]
  user_id uuid [not null]
  occurred_on date [not null]
  notes text
  reverses_transfer_id uuid [unique, note: 'Optional compensating transfer.']
  created_at timestamptz [not null, default: `now()`]
}

Table transactions {
  id uuid [pk, not null]
  user_id uuid [not null]
  account_id uuid [not null]
  occurred_on date [not null]
  amount_cents bigint [not null, note: 'Non-zero signed amount: positive credit, negative debit.']
  currency char(3) [not null, default: 'USD']
  description varchar(500) [not null]
  identifier varchar(255)
  category_id uuid [not null]
  notes text
  status transaction_status [not null, default: 'posted']
  reconciled_at timestamptz
  reconciled_by_user_id uuid
  transfer_id uuid [note: 'Set only for immutable transfer entries.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  deleted_by_user_id uuid
  version integer [not null, default: 1, note: 'Increment on each permitted edit for optimistic concurrency.']

  indexes {
    (account_id, occurred_on, created_at)
    (user_id, occurred_on)
    (category_id, occurred_on)
    (transfer_id)
    (account_id, reconciled_at)
  }
}

Table scheduled_transactions {
  id uuid [pk, not null]
  user_id uuid [not null]
  account_id uuid [not null]
  amount_cents bigint [not null, note: 'Non-zero signed amount.']
  currency char(3) [not null, default: 'USD']
  description varchar(500) [not null]
  identifier varchar(255)
  category_id uuid [not null]
  notes text
  day_of_month smallint [not null, note: 'Monthly schedule day, constrained to 1 through 31.']
  next_due_on date [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_active, next_due_on)
  }
}

Table scheduled_transaction_occurrences {
  id uuid [pk, not null]
  scheduled_transaction_id uuid [not null]
  due_on date [not null]
  transaction_id uuid [not null, unique]
  status scheduled_occurrence_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  skipped_at timestamptz

  indexes {
    (scheduled_transaction_id, due_on) [unique]
    (status, due_on)
  }
}

Table budgets {
  id uuid [pk, not null]
  user_id uuid [not null]
  category_id uuid [not null]
  period_type budget_period_type [not null]
  period_start date [not null, note: 'First calendar day of a month or first day of a calendar year.']
  planned_amount_cents bigint [not null, note: 'Signed: expected income is positive; expected expense is negative.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, category_id, period_type, period_start) [unique]
    (user_id, period_type, period_start)
  }
}

Table database_exports {
  id uuid [pk, not null]
  requested_by_user_id uuid [not null]
  status export_status [not null, default: 'queued']
  storage_key varchar(500)
  file_name varchar(255)
  expires_at timestamptz
  error_message text
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (requested_by_user_id, created_at)
    (status, expires_at)
  }
}

Ref: sessions.user_id > users.id
Ref: accounts.owner_user_id > users.id
Ref: account_memberships.account_id > accounts.id
Ref: account_memberships.user_id > users.id
Ref: categories.user_id > users.id
Ref: transfers.user_id > users.id
Ref: transfers.reverses_transfer_id > transfers.id
Ref: transactions.user_id > users.id
Ref: transactions.account_id > accounts.id
Ref: transactions.category_id > categories.id
Ref: transactions.transfer_id > transfers.id
Ref: transactions.reconciled_by_user_id > users.id
Ref: transactions.deleted_by_user_id > users.id
Ref: scheduled_transactions.user_id > users.id
Ref: scheduled_transactions.account_id > accounts.id
Ref: scheduled_transactions.category_id > categories.id
Ref: scheduled_transaction_occurrences.scheduled_transaction_id > scheduled_transactions.id
Ref: scheduled_transaction_occurrences.transaction_id > transactions.id
Ref: budgets.user_id > users.id
Ref: budgets.category_id > categories.id
Ref: database_exports.requested_by_user_id > users.id

// Implementation constraints not expressible in DBML alone:
// - Account access requires an account_memberships row. Accounts always have one
//   owner membership, and account membership determines read/write permissions.
// - Categories, budgets, templates, and their creator fields remain user-owned;
//   account activity is authorized by account membership.
// - currency must be USD; monetary amounts must be non-zero.
// - A reconciled transaction is immutable. A deleted transaction is excluded
//   from balances, budgets, analysis, and ordinary ledger results.
// - Each transfer must have exactly two posted transaction entries: one debit
//   and one credit, in distinct accounts, with equal and opposite amounts.
//   Transfer entries cannot be edited or deleted; either entry may be reconciled
//   when its corresponding account activity has been verified.
// - Only an unreconciled, non-transfer transaction may be soft-deleted or restored.
//   No revision history is retained for unreconciled transaction edits.
// - A scheduled occurrence's transaction is initially pending and becomes posted
//   only when the user confirms it. The schedule/due-date unique index makes
//   generation idempotent after service downtime.
// - Schedules run monthly. A schedule update affects future generated work only;
//   past occurrences and transactions are not mutated.
// - budgets.period_start must match its period type.
